# Tavus conversational AI agent
TAVUS_API_KEY=
TAVUS_PAL_ID=

# OpenRouter (AI chat) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free model, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Supabase — copy this file to .env.local and fill in from
# Project Settings → API (or the Connect dialog).
#
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key, starts with sb_publishable_.
# This is the browser-safe key and replaces the legacy `anon` JWT key,
# which Supabase deprecates by the end of 2026.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key, starts with sb_secret_. Bypasses Row Level Security.
# NEVER prefix it with VITE_ and never commit it.
SUPABASE_SECRET_KEY=
